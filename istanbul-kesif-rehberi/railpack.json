{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20"
  },
  "steps": [
    {
      "name": "build",
      "commands": [
        {
          "cmd": "npm ci"
        },
        {
          "cmd": "npm run build"
        }
      ]
    }
  ],
  "deploy": {
    "startCommand": "node_modules/.bin/next start"
  }
} 