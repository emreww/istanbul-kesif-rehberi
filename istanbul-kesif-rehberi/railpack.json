{
  "$schema": "https://schema.railpack.com",
  "steps": [
    {
      "name": "packages:apt:runtime",
      "commands": [
        "apt-get update && apt-get install -y nodejs npm"
      ]
    },
    {
      "name": "build",
      "commands": [
        "npm ci",
        "npm run build"
      ]
    }
  ],
  "deploy": {
    "startCommand": "node .next/standalone/server.js"
  }
}