{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20"
  },
  "steps": [
    {
      "name": "build",
      "commands": [
        "npm ci",
        "npm run build"
      ]
    }
  ],
  "deploy": {
    "startCommand": "sh -c 'eval \"$(mise activate bash)\" && node .next/standalone/server.js'"
  }
}